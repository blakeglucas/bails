<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.BailsApp" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/bails_blue</item>
        <item name="colorPrimaryVariant">@color/bails_blue_dark</item>
        <item name="colorOnPrimary">@android:color/white</item>
        <!-- Status bar color. -->
        <item name="android:statusBarColor">@color/bails_background</item>
        <item name="android:navigationBarColor">@color/bails_background</item>
        <!-- Window background -->
        <item name="android:windowBackground">@color/bails_background</item>
    </style>
</resources>
