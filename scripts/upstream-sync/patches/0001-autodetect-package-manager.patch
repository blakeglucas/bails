diff --git a/internal/commands/tool_package_manager.go b/internal/commands/tool_package_manager.go
new file mode 100644
index 000000000..3e578a048
--- /dev/null
+++ b/internal/commands/tool_package_manager.go
@@ -0,0 +1,35 @@
+package commands
+
+import (
+	"fmt"
+	"os"
+
+	"github.com/blakeglucas/bails/internal/jspm"
+)
+
+// PackageManagerOptions holds options for `bails tool package-manager`.
+type PackageManagerOptions struct {
+	Dir     string `name:"dir" description:"Frontend directory to inspect" default:"frontend"`
+	Verbose bool   `name:"v" description:"Explain why the package manager was chosen (on stderr)"`
+}
+
+// ToolPackageManager prints the frontend's package manager (bun, pnpm, yarn or
+// npm) so Taskfiles and scripts can dispatch on it. On failure it reports the
+// reason on stderr and exits non-zero, leaving stdout empty.
+func ToolPackageManager(opts *PackageManagerOptions) error {
+	DisableFooter = true
+	dir := opts.Dir
+	if dir == "" {
+		dir = "frontend"
+	}
+	result, err := jspm.Detect(dir)
+	if err != nil {
+		fmt.Fprintln(os.Stderr, "error:", err)
+		return &applicationExitError{err: err, code: 1}
+	}
+	if opts.Verbose {
+		fmt.Fprintf(os.Stderr, "%s: %s\n", result.Name, result.Reason)
+	}
+	fmt.Print(result.Name)
+	return nil
+}
diff --git a/internal/jspm/jspm.go b/internal/jspm/jspm.go
new file mode 100644
index 000000000..2e1e2f177
--- /dev/null
+++ b/internal/jspm/jspm.go
@@ -0,0 +1,109 @@
+// Package jspm detects which JavaScript package manager a frontend uses.
+//
+// Detection order:
+//  1. the PACKAGE_MANAGER environment variable (explicit override);
+//  2. the "packageManager" field of package.json (e.g. "pnpm@9.12.0");
+//  3. a lockfile in the frontend directory;
+//  4. bun, when it is installed;
+//  5. npm, when it is installed.
+//
+// When none applies, or the detected manager is not installed, Detect fails:
+// silently switching managers would ignore the project's lockfile.
+package jspm
+
+import (
+	"encoding/json"
+	"errors"
+	"fmt"
+	"os"
+	"os/exec"
+	"path/filepath"
+	"slices"
+	"strings"
+)
+
+// EnvOverride names the environment variable that forces a package manager.
+const EnvOverride = "PACKAGE_MANAGER"
+
+// Supported lists the package managers bails can drive.
+var Supported = []string{"bun", "pnpm", "yarn", "npm"}
+
+// lockfiles maps lockfile names to their package manager, in precedence order
+// for directories that (unusually) contain more than one.
+var lockfiles = []struct{ file, manager string }{
+	{"bun.lock", "bun"},
+	{"bun.lockb", "bun"},
+	{"pnpm-lock.yaml", "pnpm"},
+	{"yarn.lock", "yarn"},
+	{"package-lock.json", "npm"},
+	{"npm-shrinkwrap.json", "npm"},
+}
+
+// ErrNotFound reports that no supported package manager is installed.
+var ErrNotFound = errors.New("no JavaScript package manager found: install bun (https://bun.sh) or npm (https://nodejs.org)")
+
+// Result is a detected package manager and why it was chosen.
+type Result struct {
+	Name   string
+	Reason string
+}
+
+// Environment abstracts process lookups so detection is testable.
+type Environment struct {
+	LookPath func(string) (string, error)
+	Getenv   func(string) string
+	ReadFile func(string) ([]byte, error)
+	Stat     func(string) (os.FileInfo, error)
+}
+
+// System is the real process environment.
+var System = Environment{LookPath: exec.LookPath, Getenv: os.Getenv, ReadFile: os.ReadFile, Stat: os.Stat}
+
+// Detect returns the package manager for the frontend in dir.
+func Detect(dir string) (Result, error) { return System.Detect(dir) }
+
+// Detect returns the package manager for the frontend in dir.
+func (env Environment) Detect(dir string) (Result, error) {
+	if name := strings.TrimSpace(env.Getenv(EnvOverride)); name != "" {
+		return env.require(name, EnvOverride+" is set")
+	}
+	if name, ok := env.declared(dir); ok {
+		return env.require(name, `package.json declares "packageManager"`)
+	}
+	for _, lock := range lockfiles {
+		if _, err := env.Stat(filepath.Join(dir, lock.file)); err == nil {
+			return env.require(lock.manager, "found "+lock.file)
+		}
+	}
+	for _, name := range []string{"bun", "npm"} {
+		if _, err := env.LookPath(name); err == nil {
+			return Result{Name: name, Reason: "no lockfile; using installed " + name}, nil
+		}
+	}
+	return Result{}, ErrNotFound
+}
+
+func (env Environment) declared(dir string) (string, bool) {
+	data, err := env.ReadFile(filepath.Join(dir, "package.json"))
+	if err != nil {
+		return "", false
+	}
+	var pkg struct {
+		PackageManager string `json:"packageManager"`
+	}
+	if json.Unmarshal(data, &pkg) != nil || pkg.PackageManager == "" {
+		return "", false
+	}
+	name, _, _ := strings.Cut(pkg.PackageManager, "@")
+	return name, true
+}
+
+func (env Environment) require(name, reason string) (Result, error) {
+	if !slices.Contains(Supported, name) {
+		return Result{}, fmt.Errorf("unsupported package manager %q (%s); supported: %s", name, reason, strings.Join(Supported, ", "))
+	}
+	if _, err := env.LookPath(name); err != nil {
+		return Result{}, fmt.Errorf("the frontend uses %s (%s), but %s is not installed", name, reason, name)
+	}
+	return Result{Name: name, Reason: reason}, nil
+}
diff --git a/internal/jspm/jspm_test.go b/internal/jspm/jspm_test.go
new file mode 100644
index 000000000..43abd5e3f
--- /dev/null
+++ b/internal/jspm/jspm_test.go
@@ -0,0 +1,77 @@
+package jspm
+
+import (
+	"errors"
+	"os"
+	"path/filepath"
+	"strings"
+	"testing"
+)
+
+func fakeEnv(installed []string, env map[string]string) Environment {
+	return Environment{
+		LookPath: func(name string) (string, error) {
+			for _, n := range installed {
+				if n == name {
+					return "/usr/bin/" + name, nil
+				}
+			}
+			return "", errors.New("not found")
+		},
+		Getenv:   func(k string) string { return env[k] },
+		ReadFile: os.ReadFile,
+		Stat:     os.Stat,
+	}
+}
+
+func write(t *testing.T, dir, name, content string) {
+	t.Helper()
+	if err := os.WriteFile(filepath.Join(dir, name), []byte(content), 0o644); err != nil {
+		t.Fatal(err)
+	}
+}
+
+func TestDetect(t *testing.T) {
+	all := []string{"bun", "pnpm", "yarn", "npm"}
+	tests := []struct {
+		name      string
+		files     map[string]string
+		installed []string
+		env       map[string]string
+		want      string
+		wantErr   string
+	}{
+		{name: "fallback prefers bun", installed: all, want: "bun"},
+		{name: "fallback to npm without bun", installed: []string{"npm", "pnpm"}, want: "npm"},
+		{name: "nothing installed", installed: nil, wantErr: ErrNotFound.Error()},
+		{name: "pnpm lockfile", files: map[string]string{"pnpm-lock.yaml": ""}, installed: all, want: "pnpm"},
+		{name: "yarn lockfile", files: map[string]string{"yarn.lock": ""}, installed: all, want: "yarn"},
+		{name: "npm lockfile beats bun fallback", files: map[string]string{"package-lock.json": "{}"}, installed: all, want: "npm"},
+		{name: "bun text lockfile", files: map[string]string{"bun.lock": ""}, installed: all, want: "bun"},
+		{name: "packageManager field beats lockfile", files: map[string]string{"package.json": `{"packageManager":"yarn@4.5.0"}`, "package-lock.json": "{}"}, installed: all, want: "yarn"},
+		{name: "env override beats everything", files: map[string]string{"pnpm-lock.yaml": ""}, installed: all, env: map[string]string{EnvOverride: "npm"}, want: "npm"},
+		{name: "detected but missing", files: map[string]string{"pnpm-lock.yaml": ""}, installed: []string{"bun", "npm"}, wantErr: "uses pnpm (found pnpm-lock.yaml), but pnpm is not installed"},
+		{name: "unsupported override", installed: all, env: map[string]string{EnvOverride: "deno"}, wantErr: `unsupported package manager "deno"`},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			dir := t.TempDir()
+			for name, content := range tt.files {
+				write(t, dir, name, content)
+			}
+			got, err := fakeEnv(tt.installed, tt.env).Detect(dir)
+			if tt.wantErr != "" {
+				if err == nil || !strings.Contains(err.Error(), tt.wantErr) {
+					t.Fatalf("Detect() error = %v, want containing %q", err, tt.wantErr)
+				}
+				return
+			}
+			if err != nil {
+				t.Fatalf("Detect() error = %v", err)
+			}
+			if got.Name != tt.want {
+				t.Fatalf("Detect() = %q (%s), want %q", got.Name, got.Reason, tt.want)
+			}
+		})
+	}
+}
